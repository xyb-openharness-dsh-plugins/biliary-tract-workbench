{
  "name": "@xyb-community/biliary-tract-workbench",
  "version": "0.1.3",
  "description": "本机优先的胆道癌（胆囊癌 / 肝内胆管癌 / 肝外胆管癌）分型与可切除性记录、黄疸与胆道引流照护、治疗线序与复查准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "public",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check dsh/server.js && node --check lib/client.js && node --check lib/layout.js && node --check prototypes/v0.2/app.js && node scripts/build-version.mjs --check && node scripts/build-public.mjs --check && node --test test/*.test.mjs && node scripts/check-schema.mjs . && node scripts/check-medical-rules.mjs . && node scripts/check-wording.mjs . && node scripts/check-workbench-package.mjs . && node scripts/check-readme.mjs . && node scripts/check-readme-shots.mjs .",
    "build:public": "node scripts/build-public.mjs",
    "check:public": "node scripts/build-public.mjs --check",
    "check:schema": "node scripts/check-schema.mjs .",
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run audit",
    "pack:check": "npm pack --dry-run",
    "check:wording": "node scripts/check-wording.mjs .",
    "build:proto": "node --disable-warning=ExperimentalWarning demo/build-prototype-data.mjs",
    "probe:proto": "node prototypes/_probe/probe.mjs",
    "check:medical": "node scripts/check-medical-rules.mjs .",
    "shots:sync": "node scripts/sync-screenshots.mjs .",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "build:version": "node scripts/build-version.mjs",
    "check:version": "node scripts/build-version.mjs --check",
    "test": "node --test test/*.test.mjs",
    "check:shots": "node scripts/check-readme-shots.mjs .",
    "check:readme": "node scripts/check-readme.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/biliary-tract-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
